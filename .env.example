# Astra DB credentials — copy to .env and fill in your values
ASTRA_DB_API_ENDPOINT=https://your-own-db-id-region.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=your_astra_token_here
ASTRA_DB_KEYSPACE=default_keyspace

# HuggingFace token — set this to suppress rate-limit warnings and get faster
# downloads.  huggingface_hub expects HF_TOKEN; HUGGINGFACE_TOKEN is also
# accepted and bridged automatically by model.py.
HUGGINGFACE_TOKEN=your_huggingface_token_here
